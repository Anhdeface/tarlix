{
  "name": "Tarlix Fast Terminal",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [7681],
  "portsAttributes": {
    "7681": {
      "label": "Tarlix Web Terminal",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.fontSize": 15,
        "workbench.startupEditor": "none"
      }
    }
  },
  "postCreateCommand": "sudo curl -sSL \"https://github.com/tsl0922/ttyd/releases/latest/download/ttyd.$(uname -m)\" -o /usr/local/bin/ttyd && sudo chmod +x /usr/local/bin/ttyd && chmod +x .devcontainer/start-terminal.sh",
  "postStartCommand": "bash .devcontainer/start-terminal.sh"
}
